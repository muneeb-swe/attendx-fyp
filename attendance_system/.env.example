# Copy this file to attendance_system/.env (or export these as real environment
# variables) before running the Django backend. Never commit the real .env file.

# Django secret key — generate a fresh one for each environment, e.g.:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Set to True only for local development
DEBUG=False

# Postgres connection string, e.g. postgres://user:password@host:5432/dbname
# Leave unset to fall back to local SQLite if your settings support that.
DATABASE_URL=

# ===== Flutter (attendance_app/) =====
# Note: attendance_app/ has its own .gitignore (Flutter-generated) that
# already covers .dart_tool/, build/, plugin files, etc. — this section
# only adds things that generator doesn't cover.
attendance_app/pubspec.lock

# Android signing — never commit these
attendance_app/android/.gradle/
attendance_app/android/local.properties
attendance_app/android/key.properties
attendance_app/android/**/*.jks
attendance_app/android/**/*.keystore

# iOS signing — never commit these
attendance_app/ios/**/*.mobileprovision
attendance_app/ios/**/*.p12
